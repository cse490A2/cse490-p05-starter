{
  "name": "CSE 490 Project 5: Blender over MCP",
  "image": "ghcr.io/arian-shamaei/cse490-p05-blender:latest",
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  "forwardPorts": [
    6080
  ],
  "portsAttributes": {
    "6080": {
      "label": "Blender window",
      "onAutoForward": "silent"
    }
  },
  "secrets": {
    "LITELLM_API_KEY": {
      "description": "Your course key from the course staff. It starts with sk-. Your harness and the chat both use it."
    },
    "PURPLE_API_KEY": {
      "description": "Your UW Purple API key. Your harness in Part 1 and OpenCode in Part 2 both use it."
    }
  },
  "containerEnv": {
    "LITELLM_BASE_URL": "https://llmproxy.cs.washington.edu",
    "BLENDER_MCP_SAFE_MODE": "1",
    "BLENDER_MCP_DISABLE_TELEMETRY": "true",
    "DISPLAY": ":1",
    "LIBGL_ALWAYS_SOFTWARE": "1",
    "GALLIUM_DRIVER": "llvmpipe",
    "HARNESS_MODEL": "DeepSeek-V4.1-Flash",
    "PURPLE_BASE_URL": "https://apim-n1ai-usw2-065882797.azure-api.net/openai/v1",
    "PURPLE_MODEL": "DeepSeek-V4.1-Flash"
  },
  "remoteEnv": {
    "PATH": "/home/vscode/.local/bin:/home/vscode/.opencode/bin:${containerEnv:PATH}"
  },
  "postCreateCommand": "bash .devcontainer/setup.sh 2>&1 | tee ~/setup.log; bash .devcontainer/install-ext.sh",
  "postStartCommand": "bash .devcontainer/install-ext.sh; bash .devcontainer/start-blender.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "vivswan.litellm-vscode-chat",
        "ms-python.python"
      ],
      "settings": {
        "workbench.secondarySideBar.defaultVisibility": "visible",
        "workbench.startupEditor": "none",
        "extensions.ignoreRecommendations": true,
        "update.showReleaseNotes": false,
        "workbench.tips.enabled": false
      }
    },
    "codespaces": {}
  },
  "postAttachCommand": "code --install-extension .devcontainer/cse490-workspace.vsix --force >/tmp/workspace-ext.log 2>&1 || true"
}
