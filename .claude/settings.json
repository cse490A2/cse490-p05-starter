{
  "env": {
    "ANTHROPIC_BASE_URL": "https://llmproxy.cs.washington.edu",
    "ANTHROPIC_MODEL": "external/sonnet-5",
    "ANTHROPIC_SMALL_FAST_MODEL": "external/haiku-4-5-20251001",
    "CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS": "1"
  },
  "apiKeyHelper": "/bin/sh -c 'echo \"$LITELLM_API_KEY\"'",
  "permissions": {
    "allow": [],
    "deny": []
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/hooks/gate.py --session-start"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__blender__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/hooks/gate.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__blender__execute_blender_code",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/hooks/progress.py"
          }
        ]
      }
    ]
  }
}
